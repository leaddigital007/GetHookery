DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gethookery

# --- LLM (Vertex AI / Gemini 3.1 Pro) -------------------------------------
LLM_DEFAULT_PROVIDER=vertex
LLM_DEFAULT_MODEL=gemini-3.1-pro
LLM_MAX_DAILY_USD=5
GOOGLE_VERTEX_PROJECT_ID=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1
# Local dev: filesystem path to a service-account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json
# Heroku: paste the full JSON of the service-account key as a single line.
# When set, GOOGLE_APPLICATION_CREDENTIALS_JSON wins over the path.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
